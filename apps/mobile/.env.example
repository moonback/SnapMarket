# URL de l'API accessible depuis le téléphone (IP locale de la machine en développement)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
EXPO_PUBLIC_WS_URL=http://192.168.1.10:3000
# Clé PUBLIQUE Stripe (pk_test_… / pk_live_…). Vide = paiement désactivé dans l'app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Identifiant de projet EAS (nécessaire aux notifications push Expo)
EXPO_PUBLIC_EAS_PROJECT_ID=
