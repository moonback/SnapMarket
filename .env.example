# =====================================================================
# SnapMarket — variables d'environnement
# Copier vers .env (racine) : cp .env.example .env
# Aucune valeur ci-dessous n'est un secret de production.
# =====================================================================

# --- Général ---------------------------------------------------------
NODE_ENV=development
# URL publique de l'API (utilisée dans les liens des emails)
API_PUBLIC_URL=http://localhost:3000
# URL de l'application (liens de vérification email / réinitialisation)
APP_PUBLIC_URL=snapmarket://
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
PORT=3000

# --- Base de données -------------------------------------------------
DATABASE_URL=postgresql://snapmarket:snapmarket@localhost:5432/snapmarket?schema=public

# --- Redis (limitation de débit, BullMQ, adaptateur Socket.IO) --------
REDIS_URL=redis://localhost:6379

# --- Authentification ------------------------------------------------
# Générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Verrouillage du compte après N échecs de connexion sur la fenêtre (minutes)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Email (SMTP) ----------------------------------------------------
# En local : Mailpit (docker compose) — interface http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SnapMarket <no-reply@snapmarket.local>"

# --- Stockage objet S3 compatible -------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=snapmarket-media
S3_ACCESS_KEY_ID=snapmarket
S3_SECRET_ACCESS_KEY=snapmarket-dev-secret
S3_FORCE_PATH_STYLE=true
# URL publique (CDN) devant le bucket des médias publics. Vide = URL GET présignées.
MEDIA_CDN_URL=
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_DOWNLOAD_URL_TTL_SECONDS=3600

# --- Transcodage vidéo (worker) ---------------------------------------
# Binaires ffmpeg/ffprobe (installés dans l'image Docker). Sans eux, les vidéos sont refusées
# avec un motif explicite ; les images ne sont pas concernées.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_MAX_DIMENSION=1280
VIDEO_TRANSCODE_TIMEOUT_SECONDS=180

# --- Stripe Connect --------------------------------------------------
# Laisser vide : le paiement est alors INDISPONIBLE (HTTP 503), rien n'est simulé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# URLs de retour de l'onboarding vendeur Stripe Express
STRIPE_CONNECT_RETURN_URL=snapmarket://seller/stripe-return
STRIPE_CONNECT_REFRESH_URL=snapmarket://seller/stripe-refresh

# --- Paramètres métier (valeurs initiales, modifiables en admin) ------
# Commission plateforme en points de base (500 = 5 %), paramètre provisoire
PLATFORM_COMMISSION_BPS=500
STORY_TTL_HOURS=24

# --- Notifications push Expo -----------------------------------------
# Optionnel : jeton d'accès Expo si la sécurité push renforcée est activée
EXPO_ACCESS_TOKEN=

# --- Administration web (apps/admin/.env.local) -----------------------
# ADMIN_API_URL=http://localhost:3000/api/v1
# ADMIN_COOKIE_SECURE=false

# --- Mobile (apps/mobile/.env) ---------------------------------------
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
# EXPO_PUBLIC_WS_URL=http://192.168.1.10:3000
